{
  "expo": {
    "name": "Purrcast",
    "slug": "purrcast",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "purrcast",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router"
    ]
  }
}
