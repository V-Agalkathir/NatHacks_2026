# Sensor processing settings. Copy to .env and tune with test_accuracy.py
READINGS_PATH=../simulator/output/readings.csv
TRUTH_EVENTS_PATH=../simulator/output/truth_events.csv
TRUTH_DAILY_PATH=../simulator/output/truth_daily.csv
OUTPUT_DIR=output

# Quiet vs busy detection
# Readings closer together than this belong to the same burst
BURST_GAP_SEC=5
STABLE_STD_G=1.5
# Calm readings at each end of a burst used for the before/after weight
EDGE_READINGS=3

# Bowls
# Smallest drop counted as eating/drinking (sick cats nibble tiny amounts)
MIN_CHANGE_G=1
REFILL_MIN_G=50
# Knocked over: a drop this big, this fast
SPILL_MIN_G=100
SPILL_MAX_SEC=5
# Weight of an empty bowl (must match the simulator)
EMPTY_FOOD_BOWL_G=150
EMPTY_WATER_BOWL_G=300

# Litter box and bed
CAT_MIN_WEIGHT_G=1500
# Litter box drop (with no cat) that counts as scooping
SCOOP_MIN_G=20
NIGHT_START=22:00
NIGHT_END=07:00
