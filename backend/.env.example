# Backend settings. Copy to .env. NEVER commit .env.
HOST=0.0.0.0
PORT=8000
# Comma-separated origins, or * for the hackathon
CORS_ORIGINS=*
# Return the hard-coded example instead of calling the engine (Day 1)
MOCK_MODE=true

# Optional: only needed if engine USE_LLM=true
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=
