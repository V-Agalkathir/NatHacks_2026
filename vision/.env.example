# Vision settings. Copy to .env
MODEL_PATH=yolov8n.pt
# 0 = webcam, or a path like samples/cat.mp4
VIDEO_SOURCE=samples/cat.mp4
CONFIDENCE=0.4
# COCO class id for "cat"
CAT_CLASS_ID=15
# Seconds inside a zone before it counts as a visit
MIN_VISIT_SEC=3
EVENTS_OUT=events.csv

# Optional: for downloading the CAT BEHAVIOR dataset
ROBOFLOW_API_KEY=
