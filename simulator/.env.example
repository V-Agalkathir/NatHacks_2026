# Optional local settings: copy this file to .env to override the defaults in
# generate.py. The real .env is git-ignored; never commit it.

# Daily truth-data generation
# Number of calendar days to simulate.
DAYS=60
# Seed for repeatable day-to-day random variation.
SEED=42
# Date of simulation day 1, formatted YYYY-MM-DD.
START_DATE=2026-09-10
# 1-based simulation day when gradual scenarios begin.
# Example: 40 means the 40th day after START_DATE.
ONSET_DAY=40
# Directory for generated files, relative to simulator/ unless an absolute path.
OUTPUT_DIR=output

# Raw-scale generation settings used by scale.py.
# Emit readings this often while a scale's weight is changing, in seconds.
BURST_SAMPLE_SEC=1
# Emit a quiet heartbeat this often while weight is stable, in seconds.
HEARTBEAT_SEC=3600
# Maximum sensor-noise amplitude, in grams.
NOISE_G=0.5
# Simulated water-weight loss from evaporation, in grams per hour.
EVAPORATION_G_PER_HR=0.4
# Full food bowl weight (container plus food), in grams.
FOOD_BOWL_FULL_G=400
# Full water bowl weight (container plus water), in grams.
WATER_BOWL_FULL_G=900
# Empty litter-box scale baseline (box plus litter), in grams.
LITTER_BOX_BASE_G=6000
# Empty bed-scale baseline, in grams.
BED_BASE_G=1500
# Optional breathing-wave amplitude for bed readings, in grams; 0 disables it.
BREATH_AMP_G=0
