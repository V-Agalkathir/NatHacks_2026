# Simulator settings. Copy to .env
DAYS=60
SEED=42
START_DATE=2026-09-10
# Day the illness scenarios start (must be after the 14-day baseline)
ONSET_DAY=40
OUTPUT_DIR=output

# Fake hardware behaviour
SAMPLE_SEC=5
NOISE_G=0.5
EVAPORATION_G_PER_HR=0.4
FOOD_BOWL_FULL_G=400
WATER_BOWL_FULL_G=900
LITTER_BOX_BASE_G=6000
BED_BASE_G=1500
# Stretch: breathing wobble on the bed scale
BREATH_AMP_G=0
