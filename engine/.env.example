# Engine thresholds. Copy to .env and tune if a demo cat gets the wrong level.
DATA_PATH=../simulator/output/daily.csv
CATS_PATH=../simulator/output/cats.json
BASELINE_DAYS=14
TREND_WINDOW_DAYS=10
# Minimum % change per week to count as a real trend
TREND_PCT_PER_WEEK=10
BLIP_Z=2.0
URGENT_Z=3.0
# Set true to let an LLM rewrite explanations (key lives in backend/.env)
USE_LLM=false
